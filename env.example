# Supabase connection (required for the app to read/write real data)
# These are set as Environment Variables on Vercel for production.
# You can also override them at runtime via the in-app "Supabase Settings" modal.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY"
